# =============================================================================
# FRONTEND (Vite) — these values are shipped to the browser, so they must only
# ever be the PUBLIC Supabase URL and anon key. Never put MSG91 or the service
# role key here.
# =============================================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Authentication provider.
#   mvp      - single built-in Admin login checked in the browser (MVP default)
#   supabase - real per-user Supabase Authentication
VITE_AUTH_PROVIDER=mvp

# MVP admin credentials. The password is stored ONLY as a SHA-256 hash, never in
# plaintext and never in the database. Generate a new one with:
#   node -e "console.log(require('crypto').createHash('sha256').update('NEW').digest('hex'))"
VITE_ADMIN_USER=Admin
VITE_ADMIN_PASSWORD_SHA256=replace-with-your-own-sha256-hash

# SMS/OTP verification switch.
#   true  (default) - agents send an OTP and the customer reads it back
#   false           - no SMS at all; agents tick "Mobile verified" by hand
# When set to false you must ALSO run, in the Supabase SQL editor:
#   update public.app_config set otp_enforcement = false;
# otherwise the database will refuse to store a manually verified lead.
VITE_SMS_OTP_ENABLED=true

# =============================================================================
# EDGE FUNCTION SECRETS — set with `supabase secrets set KEY=value`, NOT here.
# This block documents what the send-otp / verify-otp functions expect.
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the platform.)
# =============================================================================

# --- MSG91 (required in production) ---
# MSG91_AUTH_KEY=your-msg91-auth-key
# MSG91_TEMPLATE_ID=your-msg91-dlt-template-id
# MSG91_SENDER_ID=MSGIND
# MSG91_ROUTE=otp                 # "otp" (api/v5/otp) or "flow" (api/v5/flow/)
# MSG91_OTP_VAR_NAME=OTP          # flow route only: the variable in your template

# --- OTP policy (all optional; defaults shown) ---
# OTP_PEPPER=long-random-string   # strongly recommended: salts the stored hash
# OTP_LENGTH=6
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=45
# OTP_MAX_SENDS_PER_MOBILE_PER_HOUR=5
# OTP_MAX_SENDS_PER_IP_PER_HOUR=40

# --- CORS ---
# ALLOWED_ORIGINS=https://leads.yourdomain.com,http://localhost:5173

# --- Local development only ---
# When MSG91 is not configured yet, OTP_DEV_MODE=true returns the OTP in the API
# response instead of sending an SMS. MUST stay false/unset in production.
# OTP_DEV_MODE=false
